# Airwallex sandbox — Account > Developer > API keys at sandbox.airwallex.com
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Anthropic — Claude reads the message and calls the read and draft tools.
# Sonnet keeps context across follow-ups. Haiku was faster but missed it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Policy. Payouts at or below this amount with a known supplier skip approval.
# 0 means every payout needs a human approval. That is the safe default.
AUTO_APPROVE_LIMIT_USD=0

# Asked after you say yes. Three wrong PINs lock the account; triple-click the
# title to unlock.
APPROVAL_PIN=1234

# 0 skips the live, read-only sandbox and Claude check the server runs on start.
PREFLIGHT=1
